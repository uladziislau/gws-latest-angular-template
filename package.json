{
  "name": "google-ai-studio-angular-22-template",
  "version": "1.0.0",
  "description": "The ultimate boilerplate to bypass Google AI Studio limitations and run Angular 22 (Zoneless) directly in the AI workspace container.",
  "keywords": [
    "angular 22",
    "google ai studio",
    "ai studio",
    "gemini",
    "agentic coding",
    "zoneless",
    "tailwind 4",
    "llm",
    "ai assistant",
    "vite"
  ],
  "author": "Uladzislau Darazhei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dev-Biceps/gws-latest-angular-template.git"
  },
  "scripts": {
    "build": "cross-env NG_DISABLE_VERSION_CHECK=true ng build --configuration production",
    "dev": "cross-env PORT=3000 NG_DISABLE_VERSION_CHECK=true ng serve --host 0.0.0.0 --port 3000",
    "lint": "pnpm run lint:ts && pnpm run lint:html",
    "lint:fix": "oxlint --fix",
    "lint:html": "cross-env NG_DISABLE_VERSION_CHECK=true ng lint",
    "lint:ts": "oxlint",
    "ng": "cross-env NG_DISABLE_VERSION_CHECK=true ng",
    "start": "cross-env NG_DISABLE_VERSION_CHECK=true ng serve",
    "test": "cross-env NG_DISABLE_VERSION_CHECK=true ng test",
    "watch": "cross-env NG_DISABLE_VERSION_CHECK=true ng build --watch --configuration development"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@tailwindcss/typography": "^0.5.20",
    "dompurify": "^3.4.14",
    "marked": "^18.0.10",
    "motion": "^13.1.1",
    "ngx-markdown": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.10.0",
    "angular-eslint": "^22.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.9.0",
    "jsdom": "^26.0.0",
    "oxlint": "^1.87.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.8.1"
}
